{
  "name": "sharath-babu-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "start": "npm run start --workspace=server",
    "preview": "npm run preview --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
